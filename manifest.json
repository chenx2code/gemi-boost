{
  "manifest_version": 3,
  "name": "GemiBoost - Table of Contents for Gemini",
  "version": "1.1.3",
  "description": "A powerful table of contents and chat navigator for Google Gemini Web.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/app*"],
      "css": ["styles.css"],
      "js": [
        "content-config.js",
        "content-utils.js",
        "content-storage.js",
        "content-extractor.js",
        "content-markdown.js",
        "content-sync.js",
        "content-exporter.js",
        "content-ui.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
