{
  "manifest_version": 3,
  "name": "GemiBoost - Table of Contents for Gemini",
  "version": "1.1.12",
  "description": "A powerful table of contents and chat navigator for Google Gemini Web.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GemiBoost Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/app*"],
      "css": ["styles.css"],
      "js": [
        "content-config.js",
        "content-utils.js",
        "content-storage.js",
        "content-extractor.js",
        "content-markdown.js",
        "content-sync.js",
        "content-exporter.js",
        "content-ui.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
